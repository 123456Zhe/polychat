{
  "name": "polychat",
  "version": "1.0.0",
  "private": true,
  "description": "A persistent chat server with Web, GUI and TUI clients",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "web:dev": "vite --config web-client/vite.config.js",
    "web:build": "vite build --config web-client/vite.config.js",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run web:build && npm run build:server"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "dompurify": "^3.2.6",
    "katex": "0.16.11",
    "marked": "^15.0.12",
    "proxy-agent": "^5.0.0",
    "minio": "^8.0.7",
    "simple-peer": "^9.11.1",
    "vue": "^3.5.13",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6",
    "vite": "^6.0.5"
  }
}
